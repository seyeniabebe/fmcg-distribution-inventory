# ==============================================================================
# FMCG Distribution Management System - Environment Variables Configuration
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env with real credentials to version control.
# ==============================================================================

# Server Port (Render/Railway injects PORT automatically)
PORT=8080

# Database Configuration (Option 1: Direct JDBC format)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fmcg_dms
DB_USER=fmcg_user
DB_PASSWORD=your_secure_password_here
DB_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}

# Database Configuration (Option 2: Cloud URI format used by Render/Railway)
# If DATABASE_URL is set, the application automatically converts it to JDBC.
# DATABASE_URL=postgresql://fmcg_user:your_password@render-host:5432/fmcg_dms

# Persistent Storage for Mobile Banking Payment Receipts
# Local development default: uploads/screenshots
# Cloud production with persistent volume: /var/data/screenshots
UPLOAD_DIR=uploads/screenshots

# Session Cookie Security
# Set to 'true' in production behind HTTPS/SSL
SESSION_COOKIE_SECURE=false

# Administrative Flags (Leave 'false' in normal operation)
MIGRATE_PASSWORDS=false
ROTATE_COMPROMISED_PASSWORDS=false

